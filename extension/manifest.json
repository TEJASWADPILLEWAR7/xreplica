{
  "manifest_version": 3,
  "name": "X-Replica",
  "version": "1.0",
  "description": "Generate AI replies in your own voice.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://xreplica.site/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["contentScript.js"],
      "css": ["styles.css"]
    },
    {
      "matches": [
        "https://xreplica.site/dashboard*",
        "http://localhost:3000/dashboard*"
      ],
      "js": ["authSync.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "icon.png"],
      "matches": ["https://twitter.com/*", "https://x.com/*"]
    }
  ]
}
